          "cayendo"
        ]
      }
    },
    {
      "texto": "Vamos al *oro real.* Junio de 2026, gráfico *diario.*",
      "voz": "Vamos al oro real. Junio de dos mil veintiséis, gráfico diario.",
      "entrada": "barrido",
      "escena": {
