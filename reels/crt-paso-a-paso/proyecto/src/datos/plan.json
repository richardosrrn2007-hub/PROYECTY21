          0.25
        ]
      ]
    },
    {
      "texto": "Paso dos: *C2.* Barre el mínimo hasta *4.023…*",
      "voz": "Paso dos: C2. Barre el mínimo hasta cuatro mil veintitrés…",
      "entrada": "corte",
      "escena": {
        "tipo": "propia",
        "nombre": "Oro",
        "en": [
          "barre",
          "minimo",
          "4.023"
        ],
        "modo": "barre"
      }
    },
    {
      "texto": "…y cierra de vuelta *dentro.* Eso es el *Turtle Soup.*",
      "entrada": "corte",
      "escena": {
        "tipo": "propia",
        "nombre": "Oro",
        "en": [
          "cierra",
          "dentro",
          "turtle"
        ],
        "modo": "cierre",
        "rotulo": "TURTLE SOUP"
      }
    },
    {
      "texto": "Paso tres: bajamos a *una hora.* El precio rompe su último máximo: *CHoCH.* Y vuelve al *Order Block.*",
      "voz": "Paso tres: bajamos a una hora. El precio rompe su último máximo: chok. Y vuelve al Order Block.",
      "entrada": "barrido",
      "escena": {
        "tipo": "propia",
