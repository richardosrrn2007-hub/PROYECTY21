        [
          0,
          "swoosh",
          0.25
        ]
      ]
    },
    {
      "texto": "Paso uno: *C1.* El 10 de junio, el oro deja un *rango:* de 4.067 a 4.257.",
      "voz": "Paso uno: C1. El diez de junio, el oro deja un rango: de cuatro mil sesenta y siete a cuatro mil doscientos cincuenta y siete.",
      "emocion": "[segura]",
      "entrada": "barrido",
      "escena": {
        "tipo": "propia",
        "nombre": "Oro",
        "en": [
          "rango",
