        "en": [
          "hora",
          "choch",
          "order"
        ]
      },
      "sonidos": [
        [
          0,
          "swoosh",
          0.25
        ]
      ]
    },
    {
      "texto": "*Entrada* en 4.061. *Stop* debajo del barrido, en 4.020. *TP1,* la mitad del rango. *TP2,* el máximo de C1.",
      "voz": "Entrada en cuatro mil sesenta y uno. Stop debajo del barrido, en cuatro mil veinte. TP1, la mitad del rango. TP2, el máximo de C1.",
      "entrada": "corte",
      "escena": {
