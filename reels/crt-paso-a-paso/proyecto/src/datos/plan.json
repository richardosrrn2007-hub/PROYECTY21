  "frases": [
    {
      "texto": "Voy a adivinar qué te pasó. Entraste en *largo.* Te *barrieron el stop.* Y minutos después, el precio *subió sin ti.*",
      "emocion": "[intrigante]",
      "escena": {
        "tipo": "propia",
        "nombre": "Pov",
        "en": [
          "largo",
          "barrieron",
          "subio"
        ]
      }
    },
    {
      "texto": "No fue mala suerte. Es el *CRT:* el precio fue a buscar *liquidez.*",
      "escena": {
        "tipo": "propia",
        "nombre": "Ciclo",
        "en": [
          "suerte",
          "crt",
          "liquidez"
        ]
      },
